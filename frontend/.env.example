# Frontend configuration.
#
# THIS is where Vite reads from. `vite.config.ts` sets no `envDir`, so Vite's
# default applies: the Vite project root, which is this directory.
#
# VITE_API_URL previously lived in the REPO-ROOT .env, where Vite never read it.
# Its only observable effect was to stop the backend starting: that file is
# consumed by pydantic-settings, which rejects variables the Settings model does
# not declare, so copying .env.example to .env - the documented first step -
# produced
#
#   ValidationError: 1 validation error for Settings
#   vite_api_url  Extra inputs are not permitted
#
# Copy this file to frontend/.env and edit. `frontend/.env` is gitignored.

# Where the browser should reach the API. Defaults to http://localhost:8000
# when unset (see src/lib/http.ts), which is correct for local development.
VITE_API_URL=http://localhost:8000
