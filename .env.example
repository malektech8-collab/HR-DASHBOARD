# Backend configuration
DATABASE_PATH=../warehouse/hr_analytics.duckdb
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Data mode: 'demo' (default) serves synthetic sample data and mock historical
# trend rows. Set to 'real' locally (this .env is uncommitted) to hide all
# fabricated rows for real-data use. One .env drives both dbt and the backend.
# DATA_MODE=demo

# Frontend configuration (if needed)
VITE_API_URL=http://localhost:8000

# JWT signing key for THIS deployment. REQUIRED in real mode - the backend
# refuses to serve without it, deliberately.
#
# It replaced a constant that was committed to the repository and identical in
# every deployment, so a forged admin token needed only repo access and worked
# at every customer install. Generate a fresh one PER DEPLOYMENT and never
# commit it:
#
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Rotating it invalidates every live token; users log in again.
JWT_SECRET=
